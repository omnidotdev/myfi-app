# Client-safe build-time vars for Vite
# Must be set here: runtime env alone is not enough for VITE_ vars (Vite inlines
# import.meta.env.VITE_* at build time), so a .env.production is required for the
# production image to point at the real hosts instead of the localhost fallback
VITE_BASE_URL=https://myfi.omni.dev
VITE_API_URL=https://api.myfi.omni.dev
VITE_AUTH_BASE_URL=https://identity.omni.dev
VITE_CONSOLE_URL=https://account.omni.dev
